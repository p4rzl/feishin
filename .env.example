# Browser-visible Feishin origin, without a trailing slash.
# Example: http://192.168.1.150:9180 or https://music.example.com
FEISHIN_URL=

# Plex origin reachable from the Feishin container, without credentials or a path.
# Example: http://192.168.1.150:32400
PLEX_URL=

FEISHIN_PORT=9180
FEISHIN_TAG=development
